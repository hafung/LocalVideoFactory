{
  "name": "voxweave",
  "version": "0.2.8",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "description": "声织 VoxWeave — local-first automatic video creation studio",
  "author": "VoxWeave Contributors",
  "main": "dist-electron/electron/main.js",
  "bin": {
    "voxweave": "dist-electron/cli/voxweave.js"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm build:preload && concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/electron/main.js file:dist-electron/electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/preload.cjs",
    "build": "tsc -p tsconfig.electron.json && pnpm build:preload && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --exclude \"dist-electron/**\" --exclude \".windows-smoke/**\" --exclude \".windows-stage-*/**\"",
    "start": "electron .",
    "cli": "tsx cli/voxweave.ts",
    "verify:resources": "node scripts/verify-offline-resources.mjs",
    "smoke:qwen": "node scripts/smoke-qwen-engine.mjs",
    "smoke:prosody": "node scripts/smoke-prosody.mjs",
    "smoke:clone": "node scripts/smoke-clone.mjs",
    "smoke:sensevoice": "node scripts/smoke-sensevoice.mjs",
    "smoke:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows.ps1",
    "smoke:composition:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-composition-windows.ps1",
    "smoke:export:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-export-windows.ps1",
    "smoke:library:ui": "node scripts/smoke-library-ui.mjs",
    "smoke:scene-picker:ui": "node scripts/smoke-scene-picker-ui.mjs",
    "smoke:semantic:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-semantic-windows.ps1",
    "smoke:package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged-windows.ps1",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-offline.ps1",
    "package:win:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-installer.ps1",
    "package:win:offline-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-offline.ps1 -IncludeSetup"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.8",
    "@hyperframes/core": "0.8.38",
    "@hyperframes/player": "0.8.38",
    "@hyperframes/producer": "0.8.38",
    "@node-rs/jieba": "2.0.3",
    "commander": "^14.0.0",
    "electron-store": "^11.0.2",
    "gsap": "3.14.2",
    "lucide-react": "^0.468.0",
    "puppeteer": "25.10.0",
    "puppeteer-core": "25.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sherpa-onnx-node": "1.13.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "studio.voxweave.app",
    "productName": "声织 VoxWeave",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSES.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "VoxWeave-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
